# Copy to .env and fill in. Never commit the real .env.

# Required: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Logins/emails that can manage every environment
ADMIN_USERS=
# Set to false only for local development over plain http
COOKIE_SECURE=true
# false = legacy ?token=... redirect (token ends up in logs); true = #token=...
PORTAL_TOKEN_IN_FRAGMENT=true

# GitHub OAuth app (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Keycloak (leave empty to disable)
KEYCLOAK_URL=https://keycloak.example.org
KEYCLOAK_REALM=datalab
KEYCLOAK_CLIENT_ID=datalab-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=http://localhost:8000/auth/keycloak/callback
# true, false, or path to a CA bundle
KEYCLOAK_VERIFY_TLS=true

# JupyterHub environments
# Hubs are exposed at https://<type>.<BASE_DOMAIN>
BASE_DOMAIN=example.org
# Prefix of the labels/annotations set on managed namespaces. Keep the value
# used when your environments were created, or their creators can no longer
# manage them (admins still can).
LABEL_PREFIX=datalab
# OAuth client secret each hub uses against Keycloak, per type (JSON)
HUB_OAUTH_CLIENT_SECRETS={"ids": "", "ipcc": ""}
# Required to deploy the "dummy" hub
HUB_DUMMY_PASSWORD=
# Only for hubs created before per-namespace secrets existed
HUB_API_TOKEN_FALLBACK=

# Kafka
KAFKA_PUBLIC_HOSTS=kafka1.example.org,kafka2.example.org,kafka3.example.org
